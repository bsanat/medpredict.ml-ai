{
  "experiment": "MedPredict-SBP-v2",
  "artifact_version": "v2",
  "data_reader": "pyreadstat 1.3.1; correct SAS zero decoding; supersedes withdrawn pandas-reader v1",
  "dataset": "NHANES-2017-March-2020-pre-pandemic",
  "seed": 2026,
  "feature_order": ["age", "sex", "bmi", "totalCholesterol", "glucose"],
  "age_min": 18,
  "age_max": 79,
  "minimum_sbp_readings": 2,
  "train_fraction": 0.70,
  "validation_fraction": 0.15,
  "test_fraction": 0.15,
  "target_range_edges": [0, 110, 130, 150, 1000],
  "age_group_edges": [18, 40, 60, 80],
  "primary_metric": "weighted_mae",
  "selection_rule": "Lowest validation weighted MAE among mean, ridge, gradient boosting, MLP. Test never used for selection.",
  "ridge_alphas": [0.1, 1.0, 10.0, 100.0],
  "gradient_boosting": [
    {"max_leaf_nodes": 7, "l2_regularization": 10.0, "learning_rate": 0.05, "max_iter": 200},
    {"max_leaf_nodes": 15, "l2_regularization": 10.0, "learning_rate": 0.05, "max_iter": 200}
  ],
  "mlp": [
    {"hidden": [32, 16], "dropout": 0.0, "weight_decay": 0.01, "learning_rate": 0.001},
    {"hidden": [16], "dropout": 0.0, "weight_decay": 0.01, "learning_rate": 0.001},
    {"hidden": [32, 16], "dropout": 0.1, "weight_decay": 0.05, "learning_rate": 0.001}
  ],
  "mlp_seeds": [2026, 2027, 2028],
  "max_epochs": 500,
  "patience": 40,
  "batch_size": 128,
  "bootstrap_replicates": 1000,
  "parity_absolute_tolerance_mmhg": 0.01,
  "notes": "Research comparison; relative quality does not establish clinical suitability. Application uses best validation-selected model, MLP may remain experimental. Complete-case selection limits representativeness."
}
